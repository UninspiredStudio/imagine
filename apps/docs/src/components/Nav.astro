---
import { docHref, getNav } from "../nav";

const { sections } = await getNav();
---

<nav aria-label="Documentation" class="flex w-full flex-col gap-6">
  {
    sections.map(({ label, pages }) => (
      <div class="flex flex-col gap-1">
        {label && <span class="px-3 py-1 text-caption-bold font-caption-bold text-subtext-color">{label}</span>}
        {pages.map((page) => {
          const active = docHref(page) === decodeURI(Astro.url.pathname);
          return (
            <a
              href={docHref(page)}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-lg px-3 py-1.5",
                active
                  ? "bg-brand-100 text-body-bold font-body-bold text-brand-800"
                  : "text-body font-body text-secondary-font hover:bg-neutral-200",
              ]}
            >
              {page.data.title}
            </a>
          );
        })}
      </div>
    ))
  }
  <a
    href="https://github.com/UninspiredStudio/imagine"
    class="rounded-lg px-3 py-1.5 text-body font-body text-secondary-font hover:bg-neutral-200"
  >
    GitHub
  </a>
</nav>
