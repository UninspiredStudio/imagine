---
import { render } from "astro:content";
import Pre from "../components/Pre.astro";
import Layout from "../layouts/Layout.astro";
import { docHref, getNav } from "../nav";

export async function getStaticPaths() {
  const { pages } = await getNav();
  return pages.map((doc, index) => ({
    params: { slug: doc.id === "index" ? undefined : doc.id },
    props: { doc, previous: pages[index - 1], next: pages[index + 1] },
  }));
}

const { doc, previous, next } = Astro.props;
const { Content, headings } = await render(doc);
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
const { title, description } = doc.data;
---

<Layout title={title} description={description}>
  <article class="flex min-w-0 max-w-[720px] grow flex-col gap-8">
    <header class="flex flex-col gap-1">
      <h1 class="text-heading-1 font-heading-1 text-default-font">{title}</h1>
      <p class="text-body font-body text-subtext-color">{description}</p>
    </header>
    <div class="prose"><Content components={{ pre: Pre }} /></div>
    {
      (previous || next) && (
        <nav
          aria-label="Previous and next page"
          class="mt-auto flex justify-between gap-4 border-t border-solid border-neutral-border pt-6"
        >
          {[previous, next].map((page, index) =>
            page ? (
              <a href={docHref(page)} class:list={["group flex min-w-0 flex-col", index === 1 && "ml-auto text-right"]}>
                <span class="text-caption font-caption text-subtext-color">{index === 0 ? "Previous" : "Next"}</span>
                <span class="text-body-bold font-body-bold text-brand-700 group-hover:underline">{page.data.title}</span>
              </a>
            ) : null,
          )}
        </nav>
      )
    }
  </article>
  {
    toc.length > 0 && (
      <nav aria-label="On this page" class="sticky top-10 hidden w-48 flex-none flex-col gap-2 self-start [@media(min-width:1100px)]:flex">
        <span class="text-caption-bold font-caption-bold text-subtext-color">On this page</span>
        {toc.map(({ depth, slug, text }) => (
          <a
            href={`#${slug}`}
            class:list={["text-caption font-caption text-secondary-font hover:text-brand-700", depth === 3 && "pl-3"]}
          >
            {text}
          </a>
        ))}
      </nav>
    )
  }
</Layout>
