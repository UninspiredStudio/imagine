---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="This page does not exist.">
  <div class="flex max-w-[400px] flex-col items-center gap-1 py-16 text-center">
    <h1 class="text-heading-2 font-heading-2 text-default-font">Page not found</h1>
    <p class="text-body font-body text-subtext-color">This page does not exist, or it has moved.</p>
    <a href="/" class="mt-3 text-body-bold font-body-bold text-brand-700 hover:underline">Go to the start page</a>
  </div>
</Layout>
