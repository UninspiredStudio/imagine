# Copy to .env and fill in. Compose reads .env for the ${...} values in compose.yaml.
# Secrets are blank on purpose: Compose refuses to start while a required value is empty.

# Public URL clients use, served by your TLS proxy. Location headers are built from it.
PUBLIC_URL=https://registry.example.com

# Signs login sessions. At least 32 characters, e.g. `openssl rand -hex 32`. Changing it logs every user out.
BETTER_AUTH_SECRET=

# Optional. Comma-separated extra origins allowed to sign in, e.g. http://localhost:5173 for the Vite dev server.
TRUSTED_ORIGINS=

# There is no admin variable. The first person to sign in on an empty registry becomes admin, so sign in at PUBLIC_URL right after the first start.

# Mail carries sign-in codes and invite links. Plunk is used if PLUNK_API_KEY is set. Otherwise SMTP is used if SMTP_URL is set.
# With neither, codes and links are written to the server log. Use that for development only.
PLUNK_API_KEY=
PLUNK_API_URL=https://next-api.useplunk.com
# SMTP connection URL, e.g. smtps://user:pass@smtp.example.com:465. MAIL_FROM is required with Plunk or SMTP. With Plunk, its domain must be verified.
SMTP_URL=
MAIL_FROM=

# DATABASE_URL is a URL, so a password with @ : / ? # or % breaks it. Use hex only, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# S3 credentials. The bundled SeaweedFS (profile s3) uses the same pair.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=imagine
S3_REGION=us-east-1

# Internal S3 endpoint the server writes to. Bundled SeaweedFS is http://seaweedfs:8333.
S3_ENDPOINT=http://seaweedfs:8333

# Public S3 endpoint that presigned blob URLs point at. Clients must be able to reach it.
S3_PUBLIC_ENDPOINT=https://s3.registry.example.com

# Bundled SeaweedFS only (profile s3): signs filer RPCs and must be set, or that service will not start.
# External S3 needs none of this.
SEAWEEDFS_FILER_SIGNING_KEY=

# Optional. Defaults: 16 GiB per blob (counting bytes already uploaded) and 900 s presigned URLs.
# MAX_BLOB_BYTES=17179869184
# PRESIGN_TTL_SECONDS=900

# Optional. Five-field cron schedule for the server's cleanup sweep. Quoted because it contains spaces. Defaults to hourly.
# SWEEP_SCHEDULE="0 * * * *"
